---
import Section from '../components/layout/Section.astro';
import Hero from '../components/content/Hero.astro';
import WritingPreview from '../components/content/WritingPreview.astro';
import Perspective from '../components/content/Perspective.astro';
import WritingExplorer from '../components/content/WritingExplorer.astro';
import AuthorPreview from '../components/content/AuthorPreview.astro';
import Layout from '../layouts/MainLayout.astro';
---

<Layout>
	<Hero
		title="Exploring the unseen influences of everyday life."
		subtitle="Reflections on the quiet forces that shape how we think, work, and live."
	/>

	<Section
		spacingTop="none"
		spacingBottom="none"
		width="wide"
		background="default"
		>
		<WritingPreview />
	</Section>

	<Section
		spacingTop="none"
		spacingBottom="none"
		width="wide"
		background="dark"
		>
		<Perspective />
	</Section>

	<Section
		spacingTop="2xl"
		spacingBottom="2xl"
		width="wide"
		background="surface"
		borderBottom
	>
		<WritingExplorer />
	</Section>

	<Section
		spacingTop="2xl"
		spacingBottom="2xl"
		width="wide"
		background="default"
	>
		<AuthorPreview />
	</Section>
</Layout>