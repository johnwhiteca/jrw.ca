---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<aside class="post-sidebar" aria-label="Post topics">
			<section class="post-sidebar__section">
				<h2 class="post-sidebar__heading">Topics</h2>

				<ul class="post-sidebar__tags">
					{tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</section>
		</aside>
	)
}

<style>
	.post-sidebar {
		min-width: 0;
	}

	.post-sidebar__section {
		padding-block: 1.5rem;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.post-sidebar__heading {
		margin-bottom: 1rem;
		font-size: var(--text-lg);
	}

	.post-sidebar__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-sidebar__tags li {
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}
</style>