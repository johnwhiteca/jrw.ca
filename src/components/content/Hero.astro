---
interface Props {
	title: string;
	subtitle?: string;
}

const {
	title,
	subtitle,
}: Props = Astro.props;
---

<div class="hero">
	<div class="hero__inner">
		<div class="hero__content">
			<h1 class="hero__title">{title}</h1>

			{
				subtitle && (
					<p class="hero__subtitle">
						{subtitle}
					</p>
				)
			}
		</div>
	</div>
</div>

<style>
	.hero {
		display: flex;
		align-items: center;
		min-height: 37.5rem;
		padding-block: var(--space-xl);

		background-image:
			linear-gradient(
				90deg,
				rgba(10, 18, 15, 0.72) 0%,
				rgba(10, 18, 15, 0.48) 42%,
				rgba(10, 18, 15, 0.12) 72%,
				rgba(10, 18, 15, 0) 100%
			),
			url('/images/hero/forest-path.webp');

		background-position: center bottom;
		background-size: cover;
		background-repeat: no-repeat;
	}

	.hero__content {
		width: min(100%, 48rem);
	}

	.hero__inner {
		width: min(100% - 2rem, 75rem);
		margin-inline: auto;
	}

	.hero__title {
		max-width: 16ch;
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(var(--text-3xl), 4.5vw, 4rem);
		line-height: 1.05;
		color: white;
	}

	.hero__subtitle {
		max-width: 27rem;
		margin-top: var(--space-2xl);
		padding-left: var(--space-sm);
		font-size: clamp(var(--text-lg), 1.6vw, var(--text-xl));
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.82);
	}

	@media (max-width: 800px) {
		.hero {
			min-height: 32rem;
			background-position: 58% bottom;
		}
	}
</style>